# --- Public-facing URL (where this app is reachable) ---
# Used to build OAuth redirect URLs. Must match the App-URL / redirect URL
# you configured in the Shopify Dev Dashboard.
APP_URL=https://upload.atelier-faille.de

# --- Basic Auth (protects the whole app from public access) ---
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me

# --- Shopify ---
SHOPIFY_API_KEY=                # Client-ID from Dev Dashboard
SHOPIFY_API_SECRET=             # Client Secret (shpss_...) from Dev Dashboard
SHOPIFY_SCOPES=read_products,write_products,read_product_listings,read_files,write_files,read_inventory,write_inventory,read_publications,write_publications
SHOPIFY_STORE=                  # e.g. nvh6nq-0w.myshopify.com
SHOPIFY_ADMIN_TOKEN=            # filled automatically after OAuth install

# --- Printify ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# --- Medusa (draft catalog publish) ---
MEDUSA_ADMIN_URL=https://shop.atelier-faille.de
MEDUSA_ADMIN_EMAIL=admin@atelier-faille.de
MEDUSA_ADMIN_PASSWORD=

# --- Optional: Google Gemini ---
GEMINI_API_KEY=

# --- Remote MCP (claude.ai Web Custom Connector) ---
# OAuth-Signaturschlüssel (min. 32 Zeichen zufällig): openssl rand -hex 32
MCP_OAUTH_SECRET=
# Passwort, das beim Connector-Login im Browser eingegeben wird (gatet Live-Upload)
MCP_LOGIN_PASSWORD=
# Hinweis: Der MCP-Issuer/Resource wird aus APP_URL abgeleitet (APP_URL + /mcp).
# Batch-Limit pro upload_folder-Call (default 5)
MCP_BATCH_LIMIT=5

# --- Google Drive (Service Account, read-only) ---
# Kompletter Service-Account-JSON-Key als EINE Zeile. Den Drive-Ordner mit der
# client_email des Service-Accounts als Reader teilen. Scope: drive.readonly
GOOGLE_SERVICE_ACCOUNT_JSON=
# Downscale-Zielgröße (längste Kante, px). Default 9000 = 60" bei 150 DPI.
MCP_DESIGN_MAX_EDGE=9000
